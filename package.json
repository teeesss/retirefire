{
  "name": "retirement-planner-tests",
  "version": "1.0.0",
  "type": "module",
  "description": "Automated testing for Retirement Planner Pro",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.cjs",
    "kill-dev": "node scripts/kill-dev-server.cjs",
    "predeploy": "npm run build",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:full": "node scripts/test-all.cjs",
    "test:watch": "vitest",
    "test:all": "node tests/run_all_comprehensive.js",
    "test:e2e": "node tests/e2e_tests.js",
    "test:e2e:new": "node tests/run_e2e.js",
    "test:e2e:comprehensive": "vitest run tests/e2e/comprehensive.test.js",
    "test:e2e:visual": "vitest run tests/e2e/visual.test.js",
    "test:legacy": "node tests/run_tests.js",
    "test:data": "node tests/run_tests.js --data",
    "preupdate": "npm run test:full",
    "validate": "npm run test:full && echo '✅ All tests passed - safe to update'"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "puppeteer": "^21.0.0",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.1",
    "vite-plugin-html-inject": "^1.1.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "basic-ftp": "^5.1.0",
    "chart.js": "^4.5.1"
  }
}