{
  "name": "retirement-planner-tests",
  "version": "1.0.0",
  "description": "Automated testing for Retirement Planner Pro",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:legacy": "node tests/run_tests.js",
    "test:data": "node tests/run_tests.js --data",
    "preupdate": "npm test",
    "validate": "npm test && echo '✅ All tests passed - safe to update'"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "puppeteer": "^21.0.0",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "basic-ftp": "^5.1.0",
    "chart.js": "^4.5.1"
  }
}